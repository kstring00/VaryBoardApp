# Copy to .env.local for local development. On Vercel: Project > Settings > Environment Variables.
# Everything is optional: with nothing set, the app runs on the built-in seed content and patients'
# sessions stay on their phones. `pnpm dev` also turns on the local demo backend (clinician mode
# and syncing kept in server memory) so every screen can be tried without any account.

# --- Supabase (Postgres, RLS, Storage, clinician magic-link auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never exposed to the browser. Used by the reminder cron and `pnpm content:audit`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Canonical URL (metadata, handout QR codes). Defaults to the Vercel URL. ---
NEXT_PUBLIC_SITE_URL=https://app.thevaryboard.com

# --- Reminders (web push). Generate once with: npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@varysystems.com
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /app/api/cron/reminders.
# Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# --- Video: Mux is used when MUX_TOKEN_ID is set, otherwise Supabase Storage. ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# --- Content gate (lib/content-gate.ts). Production always hides unreviewed movements. ---
# Vercel previews show drafts under a banner; set VB_HIDE_DRAFTS=true to hide them there too.
VB_HIDE_DRAFTS=
# A non-Vercel production build (next start) hides drafts unless this is true.
VB_SHOW_DRAFTS=

# --- Local demo backend (no Supabase): clinician mode + syncing in server memory. ---
# On automatically in `next dev`. Never runs on Vercel production or when Supabase is set.
NEXT_PUBLIC_VB_DEMO=
